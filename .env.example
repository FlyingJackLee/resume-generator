# DeepSeek implements the OpenAI Chat Completions API.
RESUME_AGENT_API_KEY=
RESUME_AGENT_BASE_URL=https://api.deepseek.com
RESUME_AGENT_MODEL=deepseek-chat
RESUME_AGENT_TIMEOUT_SECONDS=180
RESUME_AGENT_HIRING_THRESHOLD=75
RESUME_AGENT_MAX_ITERATIONS=2
RESUME_AGENT_LOG_LEVEL=INFO
RESUME_AGENT_LOG_FILE=agent/data/logs/resume-agent.log

# Human Gate 等待超过这么多分钟后自动处理：Gate①（策略）直接接受 AI 生成的策略；
# Gate②（最终版本）只有 hiring_score 达到 RESUME_AGENT_HIRING_THRESHOLD 才会自动批准导出，
# 分数不够的话不管等多久都不会自动处理，继续留给人工。设为 0 关闭这个功能。
RESUME_AGENT_AUTO_APPROVE_MINUTES=5

# 可选：LangSmith 调用链路可观测性。启用后，LangGraph 工作流会自动上报 trace。
# 请注意：trace 可能包含 JD、简历内容与模型输出；仅在接受该数据流转时启用。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resume-generator-local
# 如果 API Key 关联多个 workspace，请填写对应 Workspace ID；否则保持为空。
LANGSMITH_WORKSPACE_ID=
# 非美国区域或自托管 LangSmith 才需要设置；美国云端保持为空。
LANGSMITH_ENDPOINT=
# 可选：在 Run 详情页展示 LangSmith 项目入口。填写项目页 URL，不填写则不显示按钮。
RESUME_AGENT_LANGSMITH_PROJECT_URL=
