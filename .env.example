# DeepSeek implements the OpenAI Chat Completions API.
RESUME_AGENT_API_KEY=
RESUME_AGENT_BASE_URL=https://api.deepseek.com
RESUME_AGENT_MODEL=deepseek-chat
RESUME_AGENT_TIMEOUT_SECONDS=180
RESUME_AGENT_HIRING_THRESHOLD=85
RESUME_AGENT_MAX_ITERATIONS=2
RESUME_AGENT_LOG_LEVEL=INFO
RESUME_AGENT_LOG_FILE=agent/data/logs/resume-agent.log

# 可选：LangSmith 调用链路可观测性。留空则 Run 详情页不显示"View in LangSmith"按钮。
# 前三个是 LangChain/LangSmith 生态自己的环境变量（不带 RESUME_AGENT_ 前缀），装好
# langsmith 就会自动生效，不需要额外写代码开启。
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=resume-agent
# 你自己 LangSmith 项目页的 URL，粘贴过来即可（不做精确到单条 trace 的深链接，只链接到
# 项目页，实际 trace 已经用 run_id 打了 tag，项目页里搜 run_id 能找到）：
RESUME_AGENT_LANGSMITH_PROJECT_URL=
