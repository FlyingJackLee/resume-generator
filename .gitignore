# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Test and coverage reports
.coverage
.coverage.*
htmlcov/

# Generated resume output
/web/build/
/web/data/resume.yaml
/agent/data/runs/*
!/agent/data/runs/.gitkeep
/agent/data/logs/
/agent/data/templates/

# Local-only archives and planning material
/local-archive/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*:Zone.Identifier

# MiSans 官方许可允许使用，但不允许再次分发字体文件。
/web/assets/fonts-local/

# Local secrets
.env
.env.*
!.env.example
